PORT=5000
NODE_ENV=development
# Local Docker PostgreSQL:
DATABASE_URL="postgresql://qrstudio:qrstudio_dev_password@localhost:5432/qrstudio?schema=public"
# Production Neon PostgreSQL example (use your real Neon host, database, and credentials in .env only):
# DATABASE_URL="postgresql://<user>:<password>@<ep-host>.neon.tech/<dbname>?sslmode=require"
JWT_SECRET="replace-with-a-long-random-64-char-secret-key"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
APP_URL="http://localhost:5000"
ALLOW_LOCAL_REDIRECTS=true
